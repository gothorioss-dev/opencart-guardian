{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <a href="{{ dashboard }}" data-bs-toggle="tooltip" title="{{ text_dashboard }}" class="btn btn-info"><i class="fa-solid fa-gauge"></i></a>
        <button type="submit" form="form-gtr-guardian" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <form id="form-gtr-guardian" action="{{ save }}" method="post" data-oc-toggle="ajax">
      <div class="card">
        <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
        <div class="card-body">
          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="other_gtr_guardian_status" value="0"/>
                <input type="checkbox" name="other_gtr_guardian_status" value="1" id="input-status" class="form-check-input"{% if other_gtr_guardian_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="card mt-3">
        <div class="card-header"><i class="fa-solid fa-puzzle-piece"></i> {{ text_domains }}</div>
        <div class="card-body">
          <p class="text-secondary">{{ text_domains_help }}</p>
          <div class="table-responsive">
            <table class="table table-bordered">
              <thead>
                <tr>
                  <th>{{ column_domain }}</th>
                  <th class="text-center">{{ column_enabled }}</th>
                  <th class="text-end">{{ column_action }}</th>
                </tr>
              </thead>
              <tbody>
                {% for domain in domains %}
                  <tr>
                    <td>{{ domain.name }}</td>
                    <td class="text-center">
                      <div class="form-check form-switch d-inline-block">
                        <input type="hidden" name="other_gtr_guardian_domain_{{ domain.code }}" value="0"/>
                        <input type="checkbox" name="other_gtr_guardian_domain_{{ domain.code }}" value="1" class="form-check-input"{% if domain.enabled %} checked{% endif %}/>
                      </div>
                    </td>
                    <td class="text-end">
                      <a href="{{ domain.edit }}" class="btn btn-primary btn-sm"><i class="fa-solid fa-pencil"></i> {{ button_edit }}</a>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>
{{ footer }}
