{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <a href="{{ dashboard }}" data-bs-toggle="tooltip" title="{{ text_dashboard }}" class="btn btn-info"><i class="fa-solid fa-gauge"></i></a>
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_gtr_guardian_status" value="0"/>
                <input type="checkbox" name="module_gtr_guardian_status" value="1" id="input-status" class="form-check-input"{% if module_gtr_guardian_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
    <div class="card mt-3">
      <div class="card-header"><i class="fa-solid fa-puzzle-piece"></i> {{ text_submodules }}</div>
      <div class="card-body">
        <p class="text-secondary">{{ text_submodules_help }}</p>
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <th>{{ column_name }}</th>
                <th class="text-center">{{ column_status }}</th>
                <th class="text-end">{{ column_action }}</th>
              </tr>
            </thead>
            <tbody>
              {% for submodule in submodules %}
                <tr>
                  <td>{{ submodule.name }}</td>
                  <td class="text-center">{% if submodule.installed %}{{ text_installed }}{% else %}{{ text_not_installed }}{% endif %}</td>
                  <td class="text-end text-nowrap">
                    {% if submodule.installed %}
                      <a href="{{ submodule.edit }}" data-bs-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa-solid fa-pencil"></i></a>
                      <a href="{{ submodule.uninstall }}" data-bs-toggle="tooltip" title="{{ button_uninstall }}" class="btn btn-danger"><i class="fa-solid fa-minus-circle"></i></a>
                    {% else %}
                      <a href="{{ submodule.install }}" data-bs-toggle="tooltip" title="{{ button_install }}" class="btn btn-success"><i class="fa-solid fa-plus-circle"></i></a>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        <a href="{{ other }}">{{ text_extension }} → Other</a>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#content').on('click', '.btn-success, .btn-danger', function(e) {
    var href = $(this).attr('href');

    if (!href || href.indexOf('extension/other.') === -1) {
        return;
    }

    e.preventDefault();

    var element = this;

    if ($(element).hasClass('btn-danger') && !confirm('{{ text_confirm }}')) {
        return;
    }

    $.ajax({
        url: href,
        dataType: 'json',
        beforeSend: function() {
            $(element).button('loading');
        },
        complete: function() {
            $(element).button('reset');
        },
        success: function(json) {
            $('.alert-dismissible').remove();

            if (json['error']) {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }

            if (json['success']) {
                location.reload();
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});
//--></script>
{{ footer }}
